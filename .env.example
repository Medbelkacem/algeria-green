# ---------------------------------------------------------------------------
# Algeria Green — environment variables
# Copy to `.env` and fill in. Never commit real values.
# ---------------------------------------------------------------------------

# PostgreSQL connection string (pooled). Required.
DATABASE_URL=

# Direct (non-pooled) connection, used by `prisma migrate`. Optional; falls
# back to DATABASE_URL when unset. Required with Neon/PgBouncer style pooling.
DIRECT_DATABASE_URL=

# Secret used to derive server-side security material. Required in production.
# Generate with: openssl rand -base64 48
AUTH_SECRET=

# Public origin of the deployment, e.g. https://algeria-green.vercel.app
# Used for canonical URLs, sitemap, QR links and password-reset links.
NEXT_PUBLIC_APP_URL=

# --- File storage (Vercel Blob) --------------------------------------------
# Required for photo uploads in production. Without it, uploads are rejected
# with a clear message instead of silently failing.
BLOB_READ_WRITE_TOKEN=

# --- First administrator bootstrap -----------------------------------------
# Consumed only by `npm run bootstrap:admin`, never by the running app.
ADMIN_BOOTSTRAP_EMAIL=
ADMIN_BOOTSTRAP_PASSWORD=
ADMIN_BOOTSTRAP_NAME=

# --- Email delivery (optional) ---------------------------------------------
# When unset, verification and reset links are written to the server log
# instead of being emailed. No email is ever silently dropped.
EMAIL_FROM=
SMTP_URL=

# --- Maps -------------------------------------------------------------------
# The map uses OpenStreetMap raster tiles and needs no credentials.
# Override only if you host your own tile server.
NEXT_PUBLIC_MAP_TILE_URL=
NEXT_PUBLIC_MAP_ATTRIBUTION=
